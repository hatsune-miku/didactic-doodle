{
  "name": "wal-assistant-lark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "kfc:pack": "powershell -ExecutionPolicy Bypass -File kfc-pack.ps1",
    "kfc:pack:macos": "sh scripts/kfc-pack-macos.sh",
    "kfc:publish": "node kfc-publish.mjs",
    "kfc:release": "powershell -ExecutionPolicy Bypass -File kfc-release.ps1",
    "test:editor": "vitest run --config vitest.editor.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"src-editor/src/**/*.{ts,tsx,scss}\" \"shared/**/*.scss\" \"*config*.{ts,cjs}\" \"tests/ui/**/*.tsx\" \"src-editor/vite.config.ts\" \"kfc-publish.mjs\" \".prettierrc.cjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"src-editor/src/**/*.{ts,tsx,scss}\" \"shared/**/*.scss\" \"*config*.{ts,cjs}\" \"tests/ui/**/*.tsx\" \"src-editor/vite.config.ts\" \"kfc-publish.mjs\" \".prettierrc.cjs\""
  },
  "dependencies": {
    "@a1knla/cakeui": "0.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2",
    "framer-motion": "^12.23.25",
    "js-yaml": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
